{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fotos-andrade",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-18",
  "build": { "command": "npm run build" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  }
}
